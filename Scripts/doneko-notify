#!/usr/bin/env bash
# doneko-notify — fire-and-forget bridge from Claude Code / Codex → Doneko
# Must return instantly. Never block the agent.
set -euo pipefail

DONEKO_HOME="${HOME}/.doneko"
SOCK="${HOME}/Library/Application Support/Doneko/doneko.sock"
LOG_DIR="${DONEKO_HOME}/logs"
mkdir -p "${LOG_DIR}" 2>/dev/null || true

TERM_PROGRAM_VAL="${TERM_PROGRAM:-}"
TERM_SESSION_ID_VAL="${TERM_SESSION_ID:-}"
ITERM_SESSION_ID_VAL="${ITERM_SESSION_ID:-}"
PPID_VAL="${PPID:-}"
TTY_VAL="$(tty 2>/dev/null || true)"
if [[ -z "${TTY_VAL}" || "${TTY_VAL}" == "not a tty" ]]; then
  TTY_VAL=""
fi

CWD="$(pwd -P 2>/dev/null || pwd)"
EXPLICIT_SOURCE=""
EXPLICIT_KIND=""
POSITIONAL=()

for arg in "$@"; do
  case "$arg" in
    --source=*) EXPLICIT_SOURCE="${arg#--source=}" ;;
    --kind=*)   EXPLICIT_KIND="${arg#--kind=}" ;;
    --help|-h)
      echo "Usage: doneko-notify [--source=claude|codex] [--kind=started|completed|needsAttention] [codex-json]"
      exit 0
      ;;
    *) POSITIONAL+=("$arg") ;;
  esac
done

STDIN_DATA=""
if [[ ! -t 0 ]]; then
  STDIN_DATA="$(dd bs=1048576 count=1 2>/dev/null || true)"
fi

PAYLOAD_JSON=""
SOURCE="${EXPLICIT_SOURCE:-unknown}"
if [[ -n "${STDIN_DATA}" ]]; then
  PAYLOAD_JSON="${STDIN_DATA}"
  [[ -z "${EXPLICIT_SOURCE}" ]] && SOURCE="claude"
elif [[ ${#POSITIONAL[@]} -gt 0 ]]; then
  PAYLOAD_JSON="${POSITIONAL[${#POSITIONAL[@]}-1]}"
  [[ -z "${EXPLICIT_SOURCE}" ]] && SOURCE="codex"
fi

export DK_PAYLOAD="${PAYLOAD_JSON}"
export DK_SOURCE="${SOURCE}"
export DK_KIND="${EXPLICIT_KIND}"
export DK_CWD_FALLBACK="${CWD}"
export DK_TERM_PROGRAM="${TERM_PROGRAM_VAL}"
export DK_TERM_SESSION_ID="${TERM_SESSION_ID_VAL}"
export DK_ITERM_SESSION_ID="${ITERM_SESSION_ID_VAL}"
export DK_TTY="${TTY_VAL}"
export DK_PPID="${PPID_VAL}"

EVENT_JSON="$(/usr/bin/python3 - <<'PY' || true
import json, os, uuid, datetime, sys

raw = os.environ.get("DK_PAYLOAD") or ""
source = os.environ.get("DK_SOURCE") or "unknown"
kind_explicit = os.environ.get("DK_KIND") or ""
cwd_fallback = os.environ.get("DK_CWD_FALLBACK") or ""

payload = {}
if raw.strip():
    try:
        payload = json.loads(raw)
    except Exception:
        payload = {}

kind = kind_explicit or "completed"
cwd = cwd_fallback
preview = ""
session = ""

if isinstance(payload, dict) and payload.get("type") == "agent-turn-complete":
    source = "codex"
    kind = kind_explicit or "completed"
    cwd = payload.get("cwd") or cwd_fallback
    preview = payload.get("last-assistant-message") or ""
    session = str(payload.get("thread-id") or payload.get("turn-id") or "")
elif isinstance(payload, dict) and payload.get("hook_event_name"):
    if source == "unknown":
        source = "claude"
    if payload.get("stop_hook_active") is True:
        sys.exit(0)
    ev = payload.get("hook_event_name") or ""
    if not kind_explicit:
        if ev == "UserPromptSubmit":
            kind = "started"
        elif ev == "Notification":
            kind = "needsAttention"
        else:
            kind = "completed"
    cwd = payload.get("cwd") or cwd_fallback
    preview = (
        payload.get("last_assistant_message")
        or payload.get("message")
        or payload.get("prompt")
        or ""
    )
    session = str(payload.get("session_id") or "")

def truncate(s, n=120):
    s = " ".join((s or "").split())
    return s if len(s) <= n else s[:n] + "…"

project = os.path.basename(cwd.rstrip("/")) or "项目"
ppid = None
try:
    v = int(os.environ.get("DK_PPID") or "0")
    ppid = v or None
except Exception:
    pass

term_program = os.environ.get("DK_TERM_PROGRAM") or None
mapping = {
    "Apple_Terminal": "com.apple.Terminal",
    "iTerm.app": "com.googlecode.iterm2",
    "ghostty": "com.mitchellh.ghostty",
    "WarpTerminal": "dev.warp.Warp-Stable",
    "vscode": "com.microsoft.VSCode",
    "cursor": "com.todesktop.230313mzl4w4u92",
}
bundle = mapping.get(term_program) if term_program else None

event = {
    "id": str(uuid.uuid4()),
    "kind": kind,
    "source": source if source in ("claude", "codex") else "unknown",
    "cwd": cwd,
    "projectName": project,
    "preview": truncate(preview),
    "sessionID": session or None,
    "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "terminal": {
        "termProgram": term_program,
        "termSessionID": os.environ.get("DK_TERM_SESSION_ID") or None,
        "itermSessionID": os.environ.get("DK_ITERM_SESSION_ID") or None,
        "tty": os.environ.get("DK_TTY") or None,
        "parentPID": ppid,
        "bundleID": bundle,
    },
    "unread": True,
}
print(json.dumps(event, ensure_ascii=False), end="")
PY
)"

if [[ -z "${EVENT_JSON}" ]]; then
  exit 0
fi

(
  delivered=0

  if [[ -S "${SOCK}" ]]; then
    if /usr/bin/python3 - "${SOCK}" "${EVENT_JSON}" <<'PY'
import socket, sys
sock_path, payload = sys.argv[1], sys.argv[2]
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(0.35)
try:
    s.connect(sock_path)
    data = (payload if payload.endswith("\n") else payload + "\n").encode("utf-8")
    s.sendall(data)
    sys.exit(0)
except Exception:
    sys.exit(1)
finally:
    try:
        s.close()
    except Exception:
        pass
PY
    then
      delivered=1
    fi
  fi

  if [[ "${delivered}" -eq 0 ]]; then
    kind_check="$(/usr/bin/python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("kind",""))' "${EVENT_JSON}" 2>/dev/null || true)"
    if [[ "${kind_check}" != "started" ]]; then
      enc="$(/usr/bin/python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=""))' "${EVENT_JSON}" 2>/dev/null || true)"
      if [[ -n "${enc}" ]]; then
        open "doneko://event?json=${enc}" >/dev/null 2>&1 && delivered=1 || true
      fi
    fi
  fi

  if [[ "${delivered}" -eq 0 ]]; then
    /usr/bin/python3 - "${EVENT_JSON}" <<'PY' 2>/dev/null || true
import json, sys, subprocess
ev = json.loads(sys.argv[1])
if ev.get("kind") == "started":
    sys.exit(0)
title_map = {"claude": "Claude Code 已回答", "codex": "Codex 已回答"}
attn_map = {"claude": "Claude Code 需要关注", "codex": "Codex 需要关注"}
src = ev.get("source")
title = title_map.get(src, "Agent 已回答")
if ev.get("kind") == "needsAttention":
    title = attn_map.get(src, "Agent 需要关注")
subtitle = ev.get("projectName") or ""
body = (ev.get("preview") or "任务已完成")[:120]

def q(s):
    return s.replace("\\", "\\\\").replace('"', '\\"')

script = f'display notification "{q(body)}" with title "{q(title)}" subtitle "{q(subtitle)}" sound name "Glass"'
subprocess.run(["osascript", "-e", script], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
PY
  fi
) >/dev/null 2>>"${LOG_DIR}/notify.log" &

exit 0
