#!/usr/bin/env bash
# doneko-notify — fire-and-forget bridge from Claude Code / Codex / Antigravity → Doneko
# Must return instantly. Never block the agent.
set -euo pipefail

DONEKO_HOME="${HOME}/.doneko"
SOCK="${DONEKO_SOCK:-${HOME}/Library/Application Support/Doneko/doneko.sock}"
LOG_DIR="${DONEKO_HOME}/logs"
mkdir -p "${LOG_DIR}" 2>/dev/null || true

TERM_PROGRAM_VAL="${TERM_PROGRAM:-}"
TERM_SESSION_ID_VAL="${TERM_SESSION_ID:-}"
ITERM_SESSION_ID_VAL="${ITERM_SESSION_ID:-}"
GHOSTTY_SURFACE_ID_VAL="${GHOSTTY_SURFACE_ID:-}"
PPID_VAL="${PPID:-}"

# Prefer our own tty; if hooks run without a controlling tty, walk up PPID.
resolve_tty() {
  local raw pid i tty_field
  raw="$(tty 2>/dev/null || true)"
  if [[ -n "${raw}" && "${raw}" != "not a tty" ]]; then
    printf '%s\n' "${raw}"
    return 0
  fi
  pid="${PPID:-}"
  i=0
  while [[ -n "${pid}" && "${pid}" =~ ^[0-9]+$ && "${pid}" -gt 1 && "${i}" -lt 8 ]]; do
    tty_field="$(ps -o tty= -p "${pid}" 2>/dev/null | awk '{print $1}' || true)"
    if [[ -n "${tty_field}" && "${tty_field}" != "?" && "${tty_field}" != "??" && "${tty_field}" != "-" ]]; then
      if [[ "${tty_field}" == /* ]]; then
        printf '%s\n' "${tty_field}"
      else
        printf '/dev/%s\n' "${tty_field}"
      fi
      return 0
    fi
    pid="$(ps -o ppid= -p "${pid}" 2>/dev/null | awk '{print $1}' || true)"
    i=$((i + 1))
  done
  return 0
}

TTY_VAL="$(resolve_tty || true)"
TTY_VAL="$(printf '%s' "${TTY_VAL}" | tr -d '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

CWD="$(pwd -P 2>/dev/null || pwd)"
EXPLICIT_SOURCE=""
EXPLICIT_KIND=""
POSITIONAL=()

for arg in "$@"; do
  case "$arg" in
    --source=*) EXPLICIT_SOURCE="${arg#--source=}" ;;
    --kind=*)   EXPLICIT_KIND="${arg#--kind=}" ;;
    --help|-h)
      echo "Usage: doneko-notify [--source=claude|codex|antigravity] [--kind=started|completed|needsAttention] [codex-json]"
      exit 0
      ;;
    *) POSITIONAL+=("$arg") ;;
  esac
done

STDIN_DATA=""
if [[ ! -t 0 ]]; then
  STDIN_DATA="$(dd bs=1048576 count=1 2>/dev/null || true)"
fi

# Antigravity Stop hooks must print a JSON decision on stdout.
# "continue" would re-enter the loop; always emit {"decision":"stop"}.
NEED_STOP_DECISION=0
_DONEKO_STOP_EMITTED=0
maybe_need_stop_decision() {
  local src="${1:-}" kind="${2:-}" payload="${3:-}"
  if [[ "${src}" == "antigravity" && "${kind}" == "completed" ]]; then
    NEED_STOP_DECISION=1
    return
  fi
  if [[ "${payload}" == *"conversationId"* || "${src}" == "antigravity" ]]; then
    if [[ "${kind}" == "completed" || "${payload}" == *"fullyIdle"* || "${payload}" == *"terminationReason"* ]]; then
      NEED_STOP_DECISION=1
    fi
  fi
}
emit_stop_if_needed() {
  if [[ "${NEED_STOP_DECISION}" -eq 1 && "${_DONEKO_STOP_EMITTED}" -eq 0 ]]; then
    _DONEKO_STOP_EMITTED=1
    printf '%s\n' '{"decision":"stop"}'
  fi
}
trap emit_stop_if_needed EXIT

maybe_need_stop_decision "${EXPLICIT_SOURCE}" "${EXPLICIT_KIND}" "${STDIN_DATA}"

PAYLOAD_JSON=""
SOURCE="${EXPLICIT_SOURCE:-unknown}"
if [[ -n "${STDIN_DATA}" ]]; then
  PAYLOAD_JSON="${STDIN_DATA}"
  [[ -z "${EXPLICIT_SOURCE}" ]] && SOURCE="claude"
elif [[ ${#POSITIONAL[@]} -gt 0 ]]; then
  PAYLOAD_JSON="${POSITIONAL[${#POSITIONAL[@]}-1]}"
  [[ -z "${EXPLICIT_SOURCE}" ]] && SOURCE="codex"
fi

export DK_PAYLOAD="${PAYLOAD_JSON}"
export DK_SOURCE="${SOURCE}"
export DK_KIND="${EXPLICIT_KIND}"
export DK_CWD_FALLBACK="${CWD}"
export DK_TERM_PROGRAM="${TERM_PROGRAM_VAL}"
export DK_TERM_SESSION_ID="${TERM_SESSION_ID_VAL}"
export DK_ITERM_SESSION_ID="${ITERM_SESSION_ID_VAL}"
export DK_GHOSTTY_SURFACE_ID="${GHOSTTY_SURFACE_ID_VAL}"
export DK_TTY="${TTY_VAL}"
export DK_PPID="${PPID_VAL}"

EVENT_JSON="$(/usr/bin/python3 - <<'PY' || true
import json, os, uuid, datetime, sys, re

raw = os.environ.get("DK_PAYLOAD") or ""
source = os.environ.get("DK_SOURCE") or "unknown"
kind_explicit = os.environ.get("DK_KIND") or ""
cwd_fallback = os.environ.get("DK_CWD_FALLBACK") or ""

payload = {}
if raw.strip():
    try:
        payload = json.loads(raw)
    except Exception:
        payload = {}

kind = kind_explicit or "completed"
cwd = cwd_fallback
preview = ""
session = ""


def truncate(s, n=120):
    s = " ".join((s or "").split())
    return s if len(s) <= n else s[:n] + "…"


def extract_text(content):
    if isinstance(content, str):
        return content.strip()
    if isinstance(content, list):
        parts = []
        for item in content:
            if isinstance(item, str):
                parts.append(item)
            elif isinstance(item, dict):
                t = item.get("text") or item.get("content") or ""
                if isinstance(t, str):
                    parts.append(t)
        return " ".join(parts).strip()
    if isinstance(content, dict):
        return extract_text(content.get("text") or content.get("content") or "")
    return ""


def read_tail(path, max_bytes=262144):
    try:
        size = os.path.getsize(path)
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            if size > max_bytes:
                f.seek(size - max_bytes)
                f.readline()
            return f.read()
    except Exception:
        return ""


def last_assistant_from_transcript(path):
    if not path:
        return ""
    expanded = os.path.abspath(os.path.expanduser(str(path)))
    candidates = [expanded]
    base, name = os.path.split(expanded)
    if name == "transcript.jsonl":
        candidates.append(os.path.join(base, "transcript_full.jsonl"))
    for cand in candidates:
        if not os.path.isfile(cand):
            continue
        last = ""
        for line in read_tail(cand).splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except Exception:
                continue
            if not isinstance(obj, dict):
                continue
            typ = obj.get("type") or ""
            # Alert text is the last planner reply. Later MODEL tool steps
            # (RUN_COMMAND and similar) must not replace it.
            if typ != "PLANNER_RESPONSE":
                continue
            text = extract_text(obj.get("content"))
            if text:
                last = text
        if last:
            return last
    return ""


def looks_like_antigravity(p):
    if not isinstance(p, dict):
        return False
    if p.get("conversationId"):
        return True
    if "workspacePaths" in p and ("transcriptPath" in p or "fullyIdle" in p or "lastUserInput" in p):
        return True
    if "fullyIdle" in p or "terminationReason" in p:
        return True
    return False


if isinstance(payload, dict) and payload.get("type") == "agent-turn-complete":
    source = "codex"
    kind = kind_explicit or "completed"
    cwd = payload.get("cwd") or cwd_fallback
    preview = payload.get("last-assistant-message") or ""
    session = str(payload.get("thread-id") or payload.get("turn-id") or "")
elif source == "antigravity" or looks_like_antigravity(payload):
    source = "antigravity"
    workspaces = payload.get("workspacePaths") if isinstance(payload, dict) else None
    if isinstance(workspaces, list) and workspaces:
        first = workspaces[0]
        if isinstance(first, str) and first.strip():
            cwd = first
        elif isinstance(first, dict):
            cwd = first.get("path") or first.get("uri") or cwd_fallback
    else:
        cwd = ((payload.get("cwd") if isinstance(payload, dict) else None) or cwd_fallback)

    session = str((payload.get("conversationId") if isinstance(payload, dict) else None) or "")
    last_input = (payload.get("lastUserInput") if isinstance(payload, dict) else None) or ""
    reason = str((payload.get("terminationReason") if isinstance(payload, dict) else None) or "")
    err = payload.get("error") if isinstance(payload, dict) else None
    err_text = err.strip() if isinstance(err, str) else ""
    is_stop = (
        kind_explicit == "completed"
        or (isinstance(payload, dict) and ("fullyIdle" in payload or "terminationReason" in payload))
    )
    is_error = reason.lower() == "error" or bool(err_text)
    if is_stop:
        kind = "completed"
        # Background work still running: skip the alert (a later Stop should follow).
        # Errors are still reported even if fullyIdle is false.
        if isinstance(payload, dict) and payload.get("fullyIdle") is False and not is_error:
            sys.exit(0)
        preview = last_assistant_from_transcript(payload.get("transcriptPath") if isinstance(payload, dict) else None)
        if not preview:
            preview = last_input or err_text or "任务完成"
        if is_error and not preview.startswith("出错："):
            preview = "出错：" + (preview if preview != "任务完成" else (err_text or "任务完成"))
    else:
        kind = kind_explicit or "started"
        preview = last_input
elif isinstance(payload, dict) and payload.get("hook_event_name"):
    if source == "unknown":
        source = "claude"
    if payload.get("stop_hook_active") is True:
        sys.exit(0)
    ev = payload.get("hook_event_name") or ""
    if not kind_explicit:
        if ev == "UserPromptSubmit":
            kind = "started"
        elif ev == "Notification":
            kind = "needsAttention"
        else:
            kind = "completed"
    cwd = payload.get("cwd") or cwd_fallback
    preview = (
        payload.get("last_assistant_message")
        or payload.get("message")
        or payload.get("prompt")
        or ""
    )
    session = str(payload.get("session_id") or "")


def normalize_tty(t):
    if not t:
        return None
    t = str(t).strip()
    if not t or t in ("not a tty", "?", "??", "-"):
        return None
    if t.startswith("/dev/"):
        return t
    if re.match(r"^ttys?\d+$", t) or re.match(r"^pts/\d+$", t):
        return "/dev/" + t
    return t

project = os.path.basename(cwd.rstrip("/")) or "项目"
ppid = None
try:
    v = int(os.environ.get("DK_PPID") or "0")
    ppid = v or None
except Exception:
    pass

term_program = os.environ.get("DK_TERM_PROGRAM") or None
mapping = {
    "Apple_Terminal": "com.apple.Terminal",
    "iTerm.app": "com.googlecode.iterm2",
    "ghostty": "com.mitchellh.ghostty",
    "WarpTerminal": "dev.warp.Warp-Stable",
    "vscode": "com.microsoft.VSCode",
    "cursor": "com.todesktop.230313mzl4w4u92",
}
bundle = mapping.get(term_program) if term_program else None
ghostty_surface = os.environ.get("DK_GHOSTTY_SURFACE_ID") or None
if ghostty_surface == "":
    ghostty_surface = None

event = {
    "id": str(uuid.uuid4()),
    "kind": kind,
    "source": source if source in ("claude", "codex", "antigravity") else "unknown",
    "cwd": cwd,
    "projectName": project,
    "preview": truncate(preview),
    "sessionID": session or None,
    "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "terminal": {
        "termProgram": term_program,
        "termSessionID": os.environ.get("DK_TERM_SESSION_ID") or None,
        "itermSessionID": os.environ.get("DK_ITERM_SESSION_ID") or None,
        "ghosttySurfaceID": ghostty_surface,
        "tty": normalize_tty(os.environ.get("DK_TTY") or None),
        "parentPID": ppid,
        "bundleID": bundle,
    },
    "unread": True,
}
print(json.dumps(event, ensure_ascii=False), end="")
PY
)"

if [[ -z "${EVENT_JSON}" ]]; then
  emit_stop_if_needed
  exit 0
fi

# Refresh the stop-decision flag from the built event (covers payload auto-detect).
EVENT_META="$(/usr/bin/python3 -c 'import json,sys; e=json.loads(sys.argv[1]); print(e.get("source",""), e.get("kind",""))' "${EVENT_JSON}" 2>/dev/null || true)"
maybe_need_stop_decision ${EVENT_META:-} ""

if [[ "${DONEKO_DRY_RUN:-}" == "1" ]]; then
  if [[ -n "${EVENT_JSON}" ]]; then
    printf "%s\n" "${EVENT_JSON}" >&2
  fi
  emit_stop_if_needed
  exit 0
fi

(
  delivered=0

  if [[ -S "${SOCK}" ]]; then
    if /usr/bin/python3 - "${SOCK}" "${EVENT_JSON}" <<'PY'
import socket, sys
sock_path, payload = sys.argv[1], sys.argv[2]
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(0.35)
try:
    s.connect(sock_path)
    data = (payload if payload.endswith("\n") else payload + "\n").encode("utf-8")
    s.sendall(data)
    sys.exit(0)
except Exception:
    sys.exit(1)
finally:
    try:
        s.close()
    except Exception:
        pass
PY
    then
      delivered=1
    fi
  fi

  if [[ "${delivered}" -eq 0 ]]; then
    kind_check="$(/usr/bin/python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("kind",""))' "${EVENT_JSON}" 2>/dev/null || true)"
    if [[ "${kind_check}" != "started" ]]; then
      enc="$(/usr/bin/python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=""))' "${EVENT_JSON}" 2>/dev/null || true)"
      if [[ -n "${enc}" ]]; then
        open "doneko://event?json=${enc}" >/dev/null 2>&1 && delivered=1 || true
      fi
    fi
  fi

  if [[ "${delivered}" -eq 0 ]]; then
    /usr/bin/python3 - "${EVENT_JSON}" <<'PY' 2>/dev/null || true
import json, sys, subprocess
ev = json.loads(sys.argv[1])
if ev.get("kind") == "started":
    sys.exit(0)
title_map = {"claude": "Claude Code 已回答", "codex": "Codex 已回答", "antigravity": "Antigravity 已回答"}
attn_map = {"claude": "Claude Code 需要关注", "codex": "Codex 需要关注", "antigravity": "Antigravity 需要关注"}
src = ev.get("source")
title = title_map.get(src, "Agent 已回答")
if ev.get("kind") == "needsAttention":
    title = attn_map.get(src, "Agent 需要关注")
subtitle = ev.get("projectName") or ""
body = (ev.get("preview") or "任务已完成")[:120]

def q(s):
    return s.replace("\\", "\\\\").replace('"', '\\"')

script = f'display notification "{q(body)}" with title "{q(title)}" subtitle "{q(subtitle)}" sound name "Glass"'
subprocess.run(["osascript", "-e", script], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
PY
  fi
) >/dev/null 2>>"${LOG_DIR}/notify.log" &

emit_stop_if_needed
exit 0
